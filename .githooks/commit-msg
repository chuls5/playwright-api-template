#!/usr/bin/env sh
# Conventional Commits: type(scope)?: subject   (merge/revert commits pass through)
msg=$(head -n1 "$1")
case "$msg" in Merge*|Revert*) exit 0;; esac
if ! printf '%s' "$msg" | grep -Eq '^(feat|fix|test|docs|refactor|chore|ci|build|perf|style|revert)(\([a-z0-9./-]+\))?!?: .{3,100}$'; then
  echo "commit-msg: not a Conventional Commit: '$msg'" >&2
  echo "  e.g. test(petstore): add L2 negative cases for getPetById" >&2
  exit 1
fi
