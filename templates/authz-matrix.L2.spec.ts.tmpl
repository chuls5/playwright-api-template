// See targets/mock-bank/tests/L2-pattern/authz-roles.L2.spec.ts for the full working version.
import { expectStatus } from '../../../../src';
import { ROLES, type Role } from '../../identities';
import { test } from '../../fixtures';

const FN = '__Function.v1__' as const;
const ALLOWED: Record<Role, boolean> = { PRIMARY: true, JOINT_OWNER: true, POWER_OF_ATTORNEY: false /* ASSUMPTION — confirm */, VIEW_ONLY: false };

test.describe(`${FN} authz`, { tag: ['@L2', '@pattern:authz', `@api:${FN}`] }, () => {
  for (const role of ROLES) {
    test(`${role} ${ALLOWED[role] ? 'can' : 'cannot'} call ${FN}`, async ({ newCustomer, fnAsUser }) => {
      const c = await newCustomer({ stakeholders: ROLES.filter((r) => r !== 'PRIMARY') });
      expectStatus(await fnAsUser(c.userFor(role)).call(FN, {}), ALLOWED[role] ? 200 : 403);
    });
  }
});
