# Copy to .env (or .env.<TEST_ENV>) and fill in. Never commit real values. Key names only here.
TEST_ENV=local
RUN_ID=
WORKERS=1

# petstore (public, no secrets)
PETSTORE_BASE_URL=https://petstore3.swagger.io/api/v3/

# mock-bank — leave unset to use the mock's built-in fake dev identities
MOCK_PORT=4010
MOCK_BANK_BASE_URL=
MOCK_BANK_PASSWORD=
MOCK_BANK_OTP=
MOCK_BANK_CORE_CLIENT_ID=
MOCK_BANK_CORE_SECRET=
MOCK_BANK_ONBOARDING_CLIENT_ID=
MOCK_BANK_ONBOARDING_SECRET=
MOCK_BANK_LIMITS_CLIENT_ID=
MOCK_BANK_LIMITS_SECRET=
MOCK_BANK_PAYMENTS_CLIENT_ID=
MOCK_BANK_PAYMENTS_SECRET=
MOCK_BANK_SERVICING_CLIENT_ID=
MOCK_BANK_SERVICING_SECRET=

# A real target (see docs/runbooks/new-target-day-1.md). Key names only; values come from your secret store.
# <PREFIX>BASE_URL=
# <PREFIX>TOKEN_URL=
# <PREFIX>CLIENT_ID=
# <PREFIX>SECRET=
# <PREFIX>USER_PASSWORD=
# <PREFIX>TEST_OTP=

# toolshop (practicesoftwaretesting.com). Blank = the vendor's published demo accounts (see targets/toolshop/config.ts).
TOOLSHOP_BASE_URL=
TOOLSHOP_ADMIN_EMAIL=
TOOLSHOP_CUSTOMER_EMAIL=
TOOLSHOP_CUSTOMER2_EMAIL=
TOOLSHOP_DEMO_PASSWORD=

# countries (GraphQL, public, no auth). Blank = https://countries.trevorblades.com/
COUNTRIES_BASE_URL=
